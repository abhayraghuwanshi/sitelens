{
  "name": "sitelens-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "SiteLens Studio — GA4, Search Console and GA4 BigQuery export analytics in a local web dashboard.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && node --no-warnings=ExperimentalWarning server/index.mjs",
    "serve": "node --no-warnings=ExperimentalWarning server/index.mjs",
    "hosted": "node --no-warnings=ExperimentalWarning server/hosted.mjs",
    "test": "node --no-warnings=ExperimentalWarning --test",
    "sync": "node scripts/sync-shared.mjs",
    "check-sql": "node scripts/check-sql.mjs",
    "check-styles": "node scripts/check-styles.mjs",
    "leads": "node scripts/reddit-leads.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "trailer": "node scripts/record-trailer.mjs",
    "trailer:video": "node scripts/record-video.mjs",
    "desktop:stage": "vite build && node scripts/stage-desktop.mjs",
    "desktop:build": "npm run desktop:stage && tauri build",
    "desktop:dev": "node scripts/desktop-live.mjs",
    "mcp": "node --no-warnings=ExperimentalWarning server/mcp.mjs",
    "desktop:preview": "npm run desktop:stage && tauri dev"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.4",
    "preact": "^11.0.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "undici": "^8.9.0",
    "yaml": "^2.9.1"
  }
}
