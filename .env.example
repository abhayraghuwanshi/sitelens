# Copy to .env and fill in. Create the client at
# https://console.cloud.google.com/apis/credentials → Create credentials → OAuth client ID
# Application type: Web application
# Authorized redirect URI: http://127.0.0.1:4318/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, for npm run leads: faster with a Reddit "script" app; it works without one. Read-only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional, for npm run post (share updates in your own subreddit). Uses the same
# script app as above, signed in as the account that posts.
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=kauzl
